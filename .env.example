# Copy this file to .env for local overrides. Never put real credentials here or in Git.
# Instrument defaults are defined in trading_assistant/config.py. To override them,
# uncomment and set all three values together, for example:
# TRADING_ASSISTANT_SYMBOL=ETH/USDT
# TRADING_ASSISTANT_BASE_ASSET=ETH
# TRADING_ASSISTANT_QUOTE_ASSET=USDT

# Optional market-data configuration:
# TRADING_ASSISTANT_EXCHANGE=kraken
# TRADING_ASSISTANT_DEFAULT_TIMEFRAME=1h
# TRADING_ASSISTANT_SUPPORTED_TIMEFRAMES='["5m","15m","1h","4h","1d"]'
# TRADING_ASSISTANT_RAW_DATA_DIR=data/raw
# TRADING_ASSISTANT_MARKET_DATA_PAGE_LIMIT=720

# Optional local persistence/logging overrides:
# TRADING_ASSISTANT_DATABASE_URL=sqlite:///data/trading_assistant.sqlite3
# TRADING_ASSISTANT_LOG_LEVEL=INFO

# Optional SQLite runtime override. The database always runs in WAL mode (that is
# a code-level property, not a setting); this only tunes the finite busy timeout
# used for the short windows where two writers overlap. It is capped at 60000 ms
# on purpose: a huge timeout hides a lock problem rather than repairing it.
# TRADING_ASSISTANT_SQLITE_BUSY_TIMEOUT_MS=5000

# Store any future integration secrets only in the untracked .env file.
